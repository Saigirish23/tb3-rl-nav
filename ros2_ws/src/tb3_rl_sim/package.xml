<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tb3_rl_sim</name>
  <version>0.1.0</version>
  <description>Gazebo simulation environment and launch assets for TB3 LiDAR Navigation RL</description>
  <maintainer email="saigirish@todo.todo">saigirish</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>gazebo_ros</depend>
  <depend>gazebo_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>turtlebot3_description</depend>
  <depend>turtlebot3_gazebo</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
