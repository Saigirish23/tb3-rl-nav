<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <!-- ROS 2 World Plugin for state services (/gazebo/set_entity_state, /gazebo/get_entity_state) -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <!-- Sun light -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Physics settings -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- 4m x 4m Boundary Walls (Centered at 0, 0) -->
    <model name="arena_walls">
      <static>true</static>
      <!-- North Wall (y = +2.05) -->
      <link name="wall_north">
        <pose>0.0 2.05 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>4.2 0.1 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>4.2 0.1 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- South Wall (y = -2.05) -->
      <link name="wall_south">
        <pose>0.0 -2.05 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>4.2 0.1 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>4.2 0.1 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- East Wall (x = +2.05) -->
      <link name="wall_east">
        <pose>2.05 0.0 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 4.0 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 4.0 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- West Wall (x = -2.05) -->
      <link name="wall_west">
        <pose>-2.05 0.0 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 4.0 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 4.0 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pre-spawned Obstacle Pool (Parked outside arena at x >= 10.0 initially) -->
    <!-- Obstacle Box 1 -->
    <model name="obstacle_box_1">
      <static>false</static>
      <pose>10.0 0.0 0.25 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.02</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.02</iyy><iyz>0</iyz><izz>0.02</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><box><size>0.3 0.3 0.5</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.3 0.3 0.5</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.3 0.5 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Box 2 -->
    <model name="obstacle_box_2">
      <static>false</static>
      <pose>10.0 1.0 0.25 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.02</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.02</iyy><iyz>0</iyz><izz>0.02</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><box><size>0.25 0.25 0.5</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.25 0.25 0.5</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.3 0.5 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Box 3 -->
    <model name="obstacle_box_3">
      <static>false</static>
      <pose>10.0 2.0 0.25 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.02</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.02</iyy><iyz>0</iyz><izz>0.02</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><box><size>0.35 0.35 0.5</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.35 0.35 0.5</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.3 0.5 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Box 4 -->
    <model name="obstacle_box_4">
      <static>false</static>
      <pose>10.0 3.0 0.25 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.02</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.02</iyy><iyz>0</iyz><izz>0.02</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><box><size>0.3 0.3 0.5</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.3 0.3 0.5</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.3 0.5 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Cylinder 1 -->
    <model name="obstacle_cyl_1">
      <static>false</static>
      <pose>11.0 0.0 0.25 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.02</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.02</iyy><iyz>0</iyz><izz>0.02</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.8 0.4 0.2 1</ambient><diffuse>0.9 0.5 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Cylinder 2 -->
    <model name="obstacle_cyl_2">
      <static>false</static>
      <pose>11.0 1.0 0.25 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.02</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.02</iyy><iyz>0</iyz><izz>0.02</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.12</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.12</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.8 0.4 0.2 1</ambient><diffuse>0.9 0.5 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Cylinder 3 -->
    <model name="obstacle_cyl_3">
      <static>false</static>
      <pose>11.0 2.0 0.25 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.02</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.02</iyy><iyz>0</iyz><izz>0.02</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.18</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.18</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.8 0.4 0.2 1</ambient><diffuse>0.9 0.5 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Cylinder 4 -->
    <model name="obstacle_cyl_4">
      <static>false</static>
      <pose>11.0 3.0 0.25 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.02</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.02</iyy><iyz>0</iyz><izz>0.02</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.8 0.4 0.2 1</ambient><diffuse>0.9 0.5 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
